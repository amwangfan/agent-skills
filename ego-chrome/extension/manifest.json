{
  "manifest_version": 3,
  "name": "Ego Chrome 桥接",
  "version": "0.3.0",
  "description": "面向 AI Agent 的本地语义浏览器自动化桥接。",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "debugger",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "重新连接 Ego Chrome 桥接"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:*"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
